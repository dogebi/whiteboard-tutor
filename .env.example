# 화이트보드 튜터 MOA 서버 설정 — 이 파일을 .env 로 복사하고 값을 채운다.
# ⚠ .env 는 .gitignore 에 있어 배포되지 않는다. 키는 절대 커밋하지 않는다.

# --- 공급자 키 (하나 이상) ---
GLM_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
INCEPTION_API_KEY=

# --- 엔드포인트/모델 재정의 (선택) ---
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
# GLM_MODEL=glm-4-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_MODEL=deepseek-chat
# GROQ_MODEL=openai/gpt-oss-20b
# OPENROUTER_MODEL=minimax/minimax-m3:free

# --- MOA 구성 (twin-company twinmind 와 동일한 방식) ---
MAIN_LLM=glm
MOA_SUBS=deepseek,groq,openrouter,glm
MOA_CACHE_TTL=300

# --- 서버 ---
MOA_HOST=127.0.0.1
MOA_PORT=8390

# --- 프록시 (중국 밖 공급자에 필요할 때만) ---
# HTTPS_PROXY=http://127.0.0.1:1099
# HTTP_PROXY=http://127.0.0.1:1099
